# Database Configurations
# Default to SQLite for local development: sqlite:///./cdss.db
# PostgreSQL syntax: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./cdss.db

# Cache Configurations (leave empty to use in-memory fallback)
# Redis syntax: redis://host:port/db_index
REDIS_URL=

# MLflow Tracking Configuration (defaults to local ./mlruns directory if empty)
# MLflow server: http://localhost:5000
MLFLOW_TRACKING_URI=

# Security & Tokens
SECRET_KEY=clinical-decision-support-super-secret-key-123456
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host and Port settings
HOST=127.0.0.1
PORT=8000
